# Copy this file to .env.local and paste your Neon connection string there.
# Do not put real credentials in this example or in NEXT_PUBLIC_* variables.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Local development origin. On Vercel, omit APP_URL to use its exact deployment
# domains, or set it to your HTTPS production/custom origin (no path).
APP_URL="http://localhost:3000"
